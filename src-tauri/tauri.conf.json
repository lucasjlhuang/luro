{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "luro",
  "version": "0.1.3",
  "identifier": "com.luro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "luro",
        "width": 500,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' blob: data: ipc: http://ipc.localhost https://0.peerjs.com wss://0.peerjs.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Shared always-on-top desk for two",
    "longDescription": "A collaborative, transparent, always-on-top desktop overlay: a shared isometric room with a notebook, corkboard, whiteboard, pomodoro timer, habit tracker and two characters, synced peer-to-peer between two desks.",
    "copyright": "Lulu & Roro",
    "publisher": "Lulu & Roro",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5M0QwMUEwNjg4MTIwRQpSV1FPRW9nR0d0Q1REZGFlMWdkUHFDZkYvOElWV1dqOWF4K2ZUOXFGV3NWQ1VRVUZaRG5jd2liSgo=",
      "endpoints": [
        "https://github.com/lucasjlhuang/luro/releases/latest/download/latest.json"
      ]
    }
  }
}
